# --- Obligatoire -------------------------------------------------------------

# Mot de passe du back-office (/admin)
ADMIN_PASSWORD=

# Secret de signature des sessions (32 caractères minimum)
# Générer : openssl rand -base64 48
AUTH_SECRET=

# --- Production : édition du contenu en ligne -----------------------------------

# Sans MONGODB_URI, le contenu est lu depuis data/content.json (lecture seule sur Vercel).
# Avec MongoDB Atlas (offre gratuite), tout est modifiable depuis /admin en production.
MONGODB_URI=
MONGODB_DB=portfolio

# --- Optionnel -------------------------------------------------------------------

# Relève la limite de l'API GitHub de 60 à 5000 requêtes/heure (token sans aucun scope)
GITHUB_TOKEN=

# Notification e-mail à chaque message reçu (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
